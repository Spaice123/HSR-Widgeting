# ---- Tier A (required, no login) ----
HSR_UID=
DISCORD_CLIENT_ID=
DISCORD_USER_ID=
DISCORD_BOT_TOKEN=

# Optional: rotate the showcased character every N hours (default 6)
ROTATE_HOURS=6

# ---- Tier B (optional, HoyoLab for MoC / PF / Apocalyptic Shadow) ----
# Use a THROWAWAY alt account (see README "alt-account mode").
HOYO_LTUID_V2=

# RECOMMENDED — auto-refresh: run `python optional-hoyolab/get_stoken.py`
# once locally; it prints these. The cookie then never goes stale.
HOYO_STOKEN=
HOYO_MID=

# FALLBACK — static cookie from browser devtools on hoyolab.com.
# Only used when HOYO_STOKEN is unset. Expires periodically.
HOYO_LTOKEN_V2=
